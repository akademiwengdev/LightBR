{
  "schemaVersion": 1,
  "id": "lightbr",
  "version": "${version}",
  "name": "LightBR",
  "description": "Chunk filtering optimization mod for ice boat racing",
  "authors": ["Mednoob", "PixelSam123"],
  "contact": {
    "discord": "https://discord.gg/kUvtxz4XNK",
    "issues": "https://discord.com/channels/1466449652160135190/1524385326184009828"
  },
  "license": "All-Rights-Reserved",
  "icon": "assets/lightbr/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "org.wengdev.lightbr.LightBR"
    ],
    "modmenu": [
      "org.wengdev.lightbr.config.ModMenuEntrypoint"
    ]
  },
  "mixins": [
    "lightbr.mixins.json",
    "lightbr.obu-legacy.mixins.json",
    "lightbr.obu-latest.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "yet_another_config_lib_v3": ">=${yacl_version}"
  },
  "suggests": {
    "modmenu": ">=${modmenu_version}",
    "sodium": ">=${sodium_version}",
    "openboatutils": ">=${obu_version}"
  },
  "custom": {
    "lightbr": {
      "protocol_version": "${protocol_version}"
    }
  }
}
